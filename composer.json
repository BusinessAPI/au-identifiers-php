    "license": "MIT",
    "authors": [{ "name": "Business API", "email": "dev@businessapi.com.au" }],
    "support": { "issues": "https://github.com/BusinessAPI/au-identifiers-php/issues", "source": "https://github.com/BusinessAPI/au-identifiers-php" },
    "require": { "php": "^8.1" },
    "require-dev": { "phpunit/phpunit": "^10.5 || ^11.0" },
    "autoload": { "psr-4": { "BusinessApi\\AuIdentifiers\\": "src/" } },
    "autoload-dev": { "psr-4": { "BusinessApi\\AuIdentifiers\\Tests\\": "tests/" } },
